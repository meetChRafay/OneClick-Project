# ==============================================================================
# OneClick Project — environment variables
#
# Nothing here is required to run the app locally: the default DATA_BACKEND
# is "mock", which uses a realistic in-memory dataset and needs zero
# external services. Copy this file to `.env.local` and fill in values only
# once you're ready to connect a real backend / integration.
# ==============================================================================

# --- Data backend ------------------------------------------------------------
# "mock" (default) | "supabase"
# Leave unset (or "mock") to run entirely on the seeded in-memory dataset.
# Set to "supabase" once you've run the migrations in supabase/migrations/
# and filled in the three variables below.
DATA_BACKEND=mock

# --- Supabase (required only when DATA_BACKEND=supabase) ---------------------
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose this to the browser. Used for admin-level
# operations (e.g. inviteUserByEmail for client invitations).
SUPABASE_SERVICE_ROLE_KEY=

# --- Google integrations (Drive / Calendar / Gmail) ---------------------------
# Google Cloud Console → APIs & Services → Credentials. Used by the adapters
# in src/lib/integrations/google-*.ts once you implement the real OAuth flow;
# the Settings → Integrations UI works today as a simulated connect flow
# without these set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI features (spec section 53 — architecture only, nothing calls this
# by default) -------------------------------------------------------------
# Set this to enable src/app/api/ai/suggest — until then it returns 501.
ANTHROPIC_API_KEY=

# --- Outbound email fallback (src/lib/integrations/email.ts) -----------------
# Any transactional provider works; only referenced if you wire dispatch.ts
# into the notification-creation call sites.
RESEND_API_KEY=
